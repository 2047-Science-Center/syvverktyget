[Desktop Entry]
Version=1.0
Type=Application
Name=Uppdatera SYV-verktyget
Comment=Hämta senaste versionen, bygg om och ladda om stationen
# @EXEC@ ersätts av install-launcher.sh med rätt sökväg till update.sh.
# Terminal=true: man ska se bygget och kunna skriva sudo-lösenord.
Exec=@EXEC@
Icon=software-update-available
Terminal=true
Categories=Game;
StartupNotify=false
